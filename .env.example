# Optional. Keep the real key in a server-side secret manager or an untracked .env file.
GEMINI_API_KEY=

# Initial administrator account. Use a unique password with at least 16 characters.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Required session-signing key. Generate with:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# Hosting platforms provide PORT. Locally this defaults to 3000.
PORT=3000

# Optional. Defaults to data/arelpro.sqlite; configure a persistent volume in production.
CRM_DB_PATH=data/arelpro.sqlite

# Optional. Defaults to data/backups; keep backups outside source control.
CRM_BACKUP_DIR=data/backups
